#include <iostream>
using namespace std;

int main() {
    float valores[10];
    float suma = 0, media;
    int contador = 0;

    for (int i = 0; i < 10; i++) {
        cout << "Ingrese el valor " << i + 1 << ": ";
        cin >> valores[i];
        suma = suma + valores[i];
    }

    media = suma / 10;

    for (int i = 0; i < 10; i++) {
        if (valores[i] > media) {
            contador++;
        }
    }

    cout << "Media: " << media << endl;
    cout << "Valores por encima de la media: " << contador << endl;

    return 0;
}
