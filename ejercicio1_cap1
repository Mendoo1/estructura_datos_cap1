#include <stdio.h>

int main() {
    float horas, tarifa, total;

    printf("Ingrese las horas trabajadas: ");
    scanf("%f", &horas);
    printf("Ingrese el costo por hora: ");
    scanf("%f", &tarifa);

    total = horas * tarifa;

    printf("Horas trabajadas: %.2f\n", horas);
    printf("Tarifa por hora: %.2f\n", tarifa);
    printf("Costo total: %.2f\n", total);

    return 0;
}
