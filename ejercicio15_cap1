#include <stdio.h>

float calcular_promedio(float a, float b, float c) {
    return (a + b + c) / 3;
}

int contar_mayores(float a, float b, float c, float promedio) {
    int contador = 0;

    if (a > promedio) {
        contador++;
    }
    if (b > promedio) {
        contador++;
    }
    if (c > promedio) {
        contador++;
    }
    return contador;
}

int main() {
    float m1, m2, m3, promedio;
    int mayores;

    printf("Ingrese la medicion 1: ");
    scanf("%f", &m1);
    printf("Ingrese la medicion 2: ");
    scanf("%f", &m2);
    printf("Ingrese la medicion 3: ");
    scanf("%f", &m3);

    promedio = calcular_promedio(m1, m2, m3);
    mayores = contar_mayores(m1, m2, m3, promedio);

    printf("Promedio: %.2f\n", promedio);
    printf("Mediciones sobre el promedio: %d\n", mayores);

    return 0;
}
