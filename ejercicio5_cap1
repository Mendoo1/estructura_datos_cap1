#include <stdio.h>

int main() {
    int registros, nodos;

    printf("Ingrese el total de registros: ");
    scanf("%d", &registros);
    printf("Ingrese el numero de nodos: ");
    scanf("%d", &nodos);

    if (nodos > 0) {
        printf("Registros por nodo: %d\n", registros / nodos);
        printf("Registros sin distribuir: %d\n", registros % nodos);
    } else {
        printf("El numero de nodos debe ser mayor que 0\n");
    }

    return 0;
}
